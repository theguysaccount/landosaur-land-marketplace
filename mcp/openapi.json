{
  "openapi": "3.1.1",
  "info": {
    "title": "Landosaur API",
    "version": "1.0.0",
    "description": "Official public inventory, direct seller listings, parcel intelligence, saved searches and Land Agent orders. Published figures retain their source definitions. It is not an offer."
  },
  "servers": [
    {
      "url": "https://landosaur.com"
    }
  ],
  "paths": {
    "/api/search/": {
      "get": {
        "operationId": "searchLand",
        "summary": "Search current official and direct land",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "buy_now",
                "auction",
                "offer",
                "direct"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_acres",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_acres",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1200,
              "description": "3\u201340 longitude,latitude vertices joined by semicolons."
            }
          },
          {
            "name": "include_closed",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "price_asc",
                "price_desc",
                "ppa_asc",
                "acres_desc",
                "deadline"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    },
    "/api/xray/": {
      "get": {
        "operationId": "parcelXray",
        "summary": "Read federal parcel and electric utility intelligence",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Xray" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["utility"],
                      "properties": {
                        "utility": { "$ref": "#/components/schemas/CountyUtility" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 18,
              "maximum": 72
            }
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": -65
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "A U.S. place or both lat and lon are required for a full X-Ray."
          },
          {
            "name": "layer",
            "in": "query",
            "schema": { "type": "string", "const": "utility" },
            "description": "Return only the electric utility data. Supply county_fips."
          },
          {
            "name": "county_fips",
            "in": "query",
            "schema": { "type": "string", "pattern": "^[0-9]{5}$" },
            "description": "Five-digit U.S. county FIPS code for the utility-only lookup. Preserve leading zeros."
          }
        ]
      }
    },
    "/api/listings/": {
      "get": {
        "operationId": "getDirectListings",
        "summary": "Read direct listings or a single listing by ID",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "storage_configured": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "listings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DirectListing"
                      }
                    },
                    "listing": {
                      "$ref": "#/components/schemas/DirectListing"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          {
            "name": "sale_mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "buy_now",
                "auction"
              ]
            }
          },
          {
            "name": "include_closed",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ]
      },
      "post": {
        "operationId": "publishDirectListing",
        "summary": "Publish a seller-authorized direct listing",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "edit_token": {
                      "type": "string"
                    },
                    "listing": {
                      "$ref": "#/components/schemas/DirectListing"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingInput"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "editDirectListing",
        "summary": "Update a listing with its seller token",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "listing": {
                      "$ref": "#/components/schemas/DirectListing"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingPatch"
              }
            }
          }
        },
        "security": [
          {
            "sellerToken": []
          },
          {}
        ]
      }
    },
    "/api/offers/": {
      "get": {
        "operationId": "getListingOffers",
        "summary": "Read current bids and reservation count",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidSummary"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "listing",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      },
      "post": {
        "operationId": "recordListingOffer",
        "summary": "Submit a real bid, Buy It Now reservation request, or written offer",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "confirmation_code": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "number"
                    },
                    "summary": {
                      "$ref": "#/components/schemas/BidSummary"
                    },
                    "checkout_url": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferInput"
              }
            }
          }
        }
      }
    },
    "/api/concierge/": {
      "get": {
        "operationId": "getLandAgentOrder",
        "summary": "Read Land Agent pricing, verify a listed parcel, or track an order",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "storage_configured": {
                      "type": "boolean"
                    },
                    "stripe_checkout_configured": {
                      "type": "boolean"
                    },
                    "initiation_fee_usd": {
                      "type": "number"
                    },
                    "concierge_fee_pct": {
                      "type": "number"
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "order": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "parcel": {
                      "$ref": "#/components/schemas/AcquisitionParcel"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^AGT-[0-9A-F]{8}$"
            }
          },
          {
            "name": "parcel_id",
            "in": "query",
            "description": "Active Landosaur listing ID. With no order code, returns public listing details and the published price where available.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "openLandAgentOrder",
        "summary": "Open a dossier and return the separate $20 Stripe checkout link",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          }
        }
      }
    },
    "/api/alerts/": {
      "get": {
        "operationId": "getLandAlert",
        "summary": "Read alert metadata or a specific alert feed",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "storage_configured": {
                      "type": "boolean"
                    },
                    "formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "alert_id": {
                      "type": "string"
                    },
                    "criteria": {
                      "$ref": "#/components/schemas/AlertInput"
                    },
                    "total_matches": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Parcel"
                      }
                    }
                  }
                }
              },
              "application/atom+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "atom",
                "rss",
                "xml"
              ]
            }
          }
        ]
      },
      "post": {
        "operationId": "createLandAlert",
        "summary": "Save filters and obtain live JSON and Atom feeds",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertInput"
              }
            }
          }
        }
      }
    },
    "/data/atlas.json": {
      "get": {
        "operationId": "getLandAtlas",
        "summary": "Read USDA agricultural benchmarks, county values and live supply",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "counties": {
                      "type": "array",
                      "items": {
                        "type": "array"
                      }
                    },
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "minimum_next_bid": {
            "type": "number"
          }
        },
        "required": [
          "error"
        ]
      },
      "Parcel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "county": {
            "type": "string"
          },
          "apn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "deal_mode": {
            "type": "string"
          },
          "is_direct": {
            "type": "boolean"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_kind": {
            "type": "string"
          },
          "acres": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "usd_per_acre": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "total": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parcel"
            }
          }
        },
        "required": [
          "ok",
          "total",
          "results"
        ]
      },
      "Xray": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": 18,
            "maximum": 72
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": -65
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "usgs": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "fema": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "nwi": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "soil": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "climate": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "roads": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "public_land": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "hazards": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "county": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "utility": {
            "$ref": "#/components/schemas/CountyUtility"
          },
          "disclaimer": {
            "type": "string"
          }
        },
        "required": [
          "lat",
          "lon",
          "checked_at",
          "utility"
        ]
      },
      "CountyUtility": {
        "type": "object",
        "properties": {
          "status": { "enum": ["ok", "unavailable"] },
          "county_fips": { "type": ["string", "null"], "pattern": "^[0-9]{5}$" },
          "state_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
          "year": { "type": ["integer", "null"] },
          "source": { "type": "string", "format": "uri" },
          "state_commission_url": { "type": ["string", "null"], "format": "uri" },
          "state_average_usd_per_kwh": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "state_average_source": { "type": ["string", "null"], "format": "uri" },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "ownership", "residential_usd_per_kwh"],
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "ownership": { "type": ["string", "null"] },
                "residential_usd_per_kwh": {
                  "type": ["number", "null"],
                  "exclusiveMinimum": 0,
                  "description": "EIA-861 bundled residential sales average in the provider's state."
                }
              }
            }
          },
          "note": { "type": "string" }
        },
        "required": ["status", "county_fips", "state_code", "year", "source", "state_commission_url",
                     "state_average_usd_per_kwh", "state_average_source", "providers", "note"]
      },
      "ListingInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": 18,
            "maximum": 72
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": -65
          },
          "state": {
