{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m lando.build dist",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/xray.js": {
      "maxDuration": 30,
      "includeFiles": "data/usda/land-index-counties.json"
    },
    "api/listings.js": {
      "maxDuration": 30,
      "includeFiles": "data/usda/land-index-counties.json"
    },
    "api/offers.js": {
      "maxDuration": 15
    },
    "api/search.js": {
      "maxDuration": 15
    },
    "api/concierge.js": {
      "maxDuration": 30,
      "includeFiles": "data/usda/land-index-counties.json"
    }
  },
  "redirects": [
    { "source": "/buying-help", "destination": "/research/buying-land/", "permanent": true },
    { "source": "/buying-help/", "destination": "/research/buying-land/", "permanent": true },
    { "source": "/opportunities", "destination": "/closing-soon/", "permanent": true },
    { "source": "/opportunities/", "destination": "/closing-soon/", "permanent": true },
    { "source": "/coverage", "destination": "/sources/", "permanent": true },
    { "source": "/coverage/", "destination": "/sources/", "permanent": true },
    { "source": "/methodology", "destination": "/land-prices/data-methodology/", "permanent": true },
    { "source": "/methodology/", "destination": "/land-prices/data-methodology/", "permanent": true },
    { "source": "/concierge", "destination": "/services/", "permanent": true },
    { "source": "/concierge/", "destination": "/services/", "permanent": true },
    { "source": "/charts", "destination": "/land-atlas/", "permanent": true },
    { "source": "/charts/", "destination": "/land-atlas/", "permanent": true },
    { "source": "/privacy", "destination": "/about/#privacy", "permanent": true },
    { "source": "/privacy/", "destination": "/about/#privacy", "permanent": true },
    { "source": "/terms", "destination": "/about/#terms", "permanent": true },
    { "source": "/terms/", "destination": "/about/#terms", "permanent": true },
    { "source": "/sell", "destination": "/list/", "permanent": true },
    { "source": "/sell/", "destination": "/list/", "permanent": true },
    { "source": "/list-land", "destination": "/list/", "permanent": true },
    { "source": "/list-land/", "destination": "/list/", "permanent": true },
    { "source": "/workspace", "destination": "/analyze/", "permanent": true },
    { "source": "/workspace/", "destination": "/analyze/", "permanent": true },
    { "source": "/workspace/:path+", "destination": "/analyze/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|sitemaps/.*\\.xml|robots\\.txt|llms\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=1800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/data/map\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
